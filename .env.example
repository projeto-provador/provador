# ── Banco de dados (PostgreSQL) ──────────────────────────────────────────────
# Local (docker compose up -d): postgres://provador:provador@localhost:5432/provador
# Produção: use a connection string do seu provedor (Neon, Supabase, RDS, Railway...)
DATABASE_URL=postgres://provador:provador@localhost:5432/provador
# Defina como "true" se o provedor exigir SSL (Neon/Supabase/Heroku normalmente sim)
DATABASE_SSL=false

# ── E-mail (SMTP via Nodemailer) ─────────────────────────────────────────────
# Funciona com qualquer SMTP: Gmail (senha de app), Brevo, Resend, SES, Mailgun...
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=seu-email@gmail.com
SMTP_PASS=sua-senha-de-app
# Remetente exibido nos e-mails
MAIL_FROM="Provador Virtual <seu-email@gmail.com>"
# Quem recebe a notificação de novo lead (pode ser mais de um, separados por vírgula)
MAIL_TO=projeto@quipeai.com.br
# Enviar e-mail de confirmação para o lead? (true/false)
MAIL_CONFIRMATION=true

# ── WhatsApp (Cloud API oficial da Meta — só envio, sem navegador) ──────────
# Crie um app em https://developers.facebook.com > WhatsApp > API Setup
# Deixe WHATSAPP_TOKEN vazio para desativar o envio por WhatsApp.
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Número (com DDI) que recebe a notificação de novo lead, ex.: 5511999999999
WHATSAPP_NOTIFY_TO=
