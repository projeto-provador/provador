# ==========================================================================
# QuipeAI — Provador (landing + backend)
# Copie para .env e preencha. Nunca comite o .env real.
# ==========================================================================

# ---- Servidor ----
PORT=3000
# Origem(ns) permitida(s) para CORS, separadas por vírgula. Use * para liberar tudo.
ALLOWED_ORIGINS=*

# ---- Banco de dados (Postgres) ----
# Opção A: uma única URL de conexão (recomendado em produção / Supabase / Neon / Render).
DATABASE_URL=postgres://usuario:senha@localhost:5432/quipeai
# Opção B: variáveis separadas (usadas se DATABASE_URL estiver vazio).
PGHOST=localhost
PGPORT=5432
PGUSER=postgres
PGPASSWORD=postgres
PGDATABASE=quipeai
# Ative SSL (true) para provedores gerenciados como Supabase/Neon/Render.
PGSSL=false

# ---- E-mail (SMTP via nodemailer) ----
# Deixe EMAIL_ENABLED=false para desligar o envio de e-mail.
EMAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=voce@gmail.com
SMTP_PASS=sua-senha-de-app
# Remetente exibido nos e-mails.
EMAIL_FROM="QuipeAI <voce@gmail.com>"
# Para onde vai a notificação de novo lead (o time).
TEAM_EMAIL=projeto@quipeai.com.br
# Enviar e-mail de confirmação ao lead quando o contato for um e-mail? (true/false)
EMAIL_CONFIRM_LEAD=true

# ---- WhatsApp ----
# Provider: none | cloud | openwa
#   none   -> não envia WhatsApp (mais simples). Ainda registra um link wa.me no log.
#   cloud  -> WhatsApp Cloud API oficial da Meta (leve, só HTTP).
#   openwa -> @open-wa/wa-automate (roda um navegador + QR code; instale a dep opcional).
WHATSAPP_PROVIDER=none
# Número do time que recebe a notificação de novo lead (formato internacional, só dígitos).
TEAM_WHATSAPP=5511999999999
# Enviar mensagem ao lead quando o contato for um telefone? (true/false)
WHATSAPP_CONFIRM_LEAD=false

# ---- WhatsApp Cloud API (só quando WHATSAPP_PROVIDER=cloud) ----
WA_CLOUD_TOKEN=
WA_CLOUD_PHONE_ID=
# Nome do template aprovado (a Cloud API exige template para iniciar conversa).
WA_CLOUD_TEMPLATE=hello_world
WA_CLOUD_LANG=pt_BR

# ---- open-wa (só quando WHATSAPP_PROVIDER=openwa) ----
OPENWA_SESSION_ID=quipeai
