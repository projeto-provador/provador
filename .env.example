# Integrações do site QuipeAI. Todas opcionais em dev; sem a variável, a
# integração correspondente fica desligada sem quebrar o site.

# Meta Pixel (Conversions API vai via GTM Server Side, fora do front).
NEXT_PUBLIC_META_PIXEL_ID=

# Google Analytics 4.
NEXT_PUBLIC_GA4_ID=

# Webhook n8n que recebe o lead do quiz 4+1 e distribui para HubSpot,
# Sheets e Slack #leads-icp-a.
NEXT_PUBLIC_N8N_WEBHOOK_URL=

# Link do Calendly para o toque 1 de 15 minutos. UTMs são repassadas.
NEXT_PUBLIC_CALENDLY_URL=https://calendly.com/quipeai/15min
